{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.EntityFrameworkCore": "Warning" }, "EventLog": { "LogLevel": { "Default": "Warning" } } },
  "Database": { "Provider": "SqlServer" },
  "ConnectionStrings": { "Wings": "Server=sql.wings.internal;Database=WingsLoadBalancer;Integrated Security=True;Encrypt=True" },
  "Redis": { "Configuration": "" },
  "Health": { "IntervalSeconds": 10, "TimeoutSeconds": 5, "MetricsIntervalSeconds": 60, "FailuresToUnhealthy": 3, "SuccessesToRecover": 3, "StabilizationSeconds": 30 },
  "Operations": { "DrainCheckSeconds": 15, "AlertEvaluationSeconds": 30, "RetentionRunHours": 6 },
  "DestinationPolicy": { "AllowedBackendHosts": [ "*.wings.internal" ], "AllowedBackendNetworks": [ "10.0.0.0/8" ] },
  "BackendTrust": { "MasterKey": null },
  "Notifications": { "SmtpHost": null, "From": "wings-lb@example.com" },
  "Seed": { "RunOnMonitor": false }
}
