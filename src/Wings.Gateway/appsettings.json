{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "Yarp": "Warning" }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "SqlServer" },
  "ConnectionStrings": {
    "Wings": "Server=sql.wings.internal;Database=WingsLoadBalancer;Integrated Security=True;Encrypt=True"
  },
  "Redis": { "Configuration": "", "KeyPrefix": "wings:" },
  "Gateway": {
    "InstanceName": null,
    "CookieName": "__Host-Wings.Session",
    "RequireHttpsCookies": true,
    "SessionIdleMinutes": 30,
    "SessionAbsoluteHours": 12,
    "MaxRequestBodyBytes": 104857600,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Routing": { "LastKnownGoodMaxAgeMinutes": 30, "TreatUnknownHealthAsHealthy": false },
  "ConfigurationSync": { "VersionPollSeconds": 15, "LastKnownGoodPath": "App_Data/routing-lkg.bin" },
  "Health": { "GatewayMode": "Shared", "FeedPollSeconds": 3, "IntervalSeconds": 10, "TimeoutSeconds": 5 },
  "DestinationPolicy": { "AllowedBackendHosts": [ "*.wings.internal" ], "AllowedBackendNetworks": [ "10.0.0.0/8" ], "AllowInsecureBackends": false, "AllowLoopback": false },
  "BackendTrust": { "MasterKey": null },
  "Seed": { "ApplyMigrations": false, "SampleData": false, "RunOnGateway": false },
  "DataProtection": { "KeyPath": null }
}
