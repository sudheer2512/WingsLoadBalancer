<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process hosting: fastest path, real client address without forwarded headers. -->
      <aspNetCore processPath="dotnet" arguments=".\Wings.Gateway.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Required for proxied WebSockets and SignalR (install the IIS "WebSocket Protocol" feature). -->
      <webSocket enabled="true" />
      <security>
        <!-- 200 MB; keep in step with Gateway:MaxRequestBodyBytes. removeServerHeader needs IIS 10+. -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
