{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "SqlServer" },
  "ConnectionStrings": { "Wings": "Server=sql.wings.internal;Database=WingsLoadBalancer;Integrated Security=True;Encrypt=True" },
  "Redis": { "Configuration": "" },
  "Admin": { "CookieName": "__Host-Wings.Admin", "RequireHttpsCookies": true, "SessionMinutes": 60, "GatewayUrl": null },
  "Monitor": { "RunInAdmin": true },
  "Health": { "IntervalSeconds": 10, "TimeoutSeconds": 5, "MetricsIntervalSeconds": 60 },
  "DestinationPolicy": { "AllowedBackendHosts": [ "*.wings.internal" ], "AllowedBackendNetworks": [ "10.0.0.0/8" ], "AllowedRedirectHosts": [] },
  "BackendTrust": { "MasterKey": null },
  "Notifications": { "SmtpHost": null, "From": "wings-lb@example.com", "AdminPortalUrl": null },
  "Seed": { "ApplyMigrations": false, "SampleData": false, "RunOnAdmin": true }
}
